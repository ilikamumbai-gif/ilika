<Row><Cell><Data ss:Type="String">Repository — public static</Data></Cell><Cell><Data ss:Type="String">voice-face-mask-makers-honest-guide-ilika-worth-it</Data></Cell><Cell><Data ss:Type="String">voice-face-mask-makers-honest-guide-ilika-worth-it</Data></Cell><Cell><Data ss:Type="String">The Honest Guide to Voice Face Mask Makers: Is the Ilika Machine Worth It?</Data></Cell><Cell><Data ss:Type="String">4</Data></Cell><Cell><Data ss:Type="String">honest-guide-mask-maker-buyer-patterns</Data></Cell><Cell><Data ss:Type="String">content-full</Data></Cell><Cell><Data ss:Type="String">What Buyer Behavior Suggests
