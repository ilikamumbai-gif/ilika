{
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "redirects": [
      { "source": "/product/facial-mask-maker-machine", "destination": "/product/voice-face-mask-maker", "type": 301 },
      { "source": "/product/facial-mask-maker-machine/", "destination": "/product/voice-face-mask-maker", "type": 301 },
      { "source": "/product/facial-kit/facial-mask-maker-machine", "destination": "/product/voice-face-mask-maker", "type": 301 },
      { "source": "/product/facial-kit/facial-mask-maker-machine/", "destination": "/product/voice-face-mask-maker", "type": 301 },
      { "source": "/leafless-hair-dryer", "destination": "https://ilika.in/product/leafless-hair-dryer", "type": 301 },
      { "source": "/leafless-hair-dryer/", "destination": "https://ilika.in/product/leafless-hair-dryer", "type": 301 }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
